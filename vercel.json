{
  "rewrites": [
    { "source": "/about", "destination": "/" },
    { "source": "/pricing", "destination": "/" },
    { "source": "/login", "destination": "/" },
    { "source": "/signup", "destination": "/" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain" }]
    }
  ]
}
